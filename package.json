{
  "name": "squeeze-plex-hub",
  "version": "1.31.0",
  "description": "Squeeze Plex Hub bridges Plexamp (Plex) with your Logitech / Lyrion Music Server ecosystem so you can play Plex audio on Squeezebox (and compatible) players.",
  "author": "onmomo",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write app/** server/**"
  },
  "dependencies": {
    "@nuxt/kit": "^4.2.0",
    "@nuxt/ui": "^4.1.0",
    "axios": "^1.13.5",
    "lms-discovery": "^1.1.0",
    "lms-squeeze-rpc-x": "1.1.0",
    "nuxt": "^4.0.0",
    "winston": "^3.17.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/test-utils": "^3.21.0",
    "@types/jest": "^30.0.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.33.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-vue": "^10.4.0",
    "happy-dom": "^20.0.2",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.8"
  },
  "packageManager": "yarn@4.4.0"
}
